# =============================================================================
# Researcher Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#
# Note:
# - This project currently uses a custom OpenAI-compatible endpoint for LLM calls.
# - Kimi worker settings are included for queue-driven experiment execution.


# =============================================================================
# Core App Runtime
# =============================================================================

ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO


# =============================================================================
# LLM Client (OpenAI-Compatible Endpoint)
# =============================================================================
# Used by triage/concept/experiment workers through src/shared/llm/openai_client.py
#
# Global defaults (applies to all agents unless overridden below):

CUSTOM_LLM_BASE_URL=https://api.openai.com/v1
CUSTOM_LLM_API_KEY=your_api_key_here
CUSTOM_LLM_MODEL=gpt-4o-mini
CUSTOM_LLM_MAX_RETRIES=3
CUSTOM_LLM_TIMEOUT_SECONDS=120

# Optional per-agent overrides (if unset, each agent falls back to CUSTOM_LLM_*):

# Paper triage agent
CUSTOM_LLM_TRIAGE_BASE_URL=
CUSTOM_LLM_TRIAGE_API_KEY=
CUSTOM_LLM_TRIAGE_MODEL=
CUSTOM_LLM_TRIAGE_MAX_RETRIES=
CUSTOM_LLM_TRIAGE_TIMEOUT_SECONDS=

# Concept generator agent
CUSTOM_LLM_CONCEPT_GEN_BASE_URL=
CUSTOM_LLM_CONCEPT_GEN_API_KEY=
CUSTOM_LLM_CONCEPT_GEN_MODEL=
CUSTOM_LLM_CONCEPT_GEN_MAX_RETRIES=
CUSTOM_LLM_CONCEPT_GEN_TIMEOUT_SECONDS=

# Experiment exploder agent
CUSTOM_LLM_EXPERIMENT_EXPLODER_BASE_URL=
CUSTOM_LLM_EXPERIMENT_EXPLODER_API_KEY=
CUSTOM_LLM_EXPERIMENT_EXPLODER_MODEL=
CUSTOM_LLM_EXPERIMENT_EXPLODER_MAX_RETRIES=
CUSTOM_LLM_EXPERIMENT_EXPLODER_TIMEOUT_SECONDS=


# =============================================================================
# PostgreSQL (DB_*)
# =============================================================================
# Loaded by src/shared/db/config.py (env_prefix=DB_)

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=researcher_agent

# Optional pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_ECHO=false


# =============================================================================
# RabbitMQ (RABBITMQ_*)
# =============================================================================
# Loaded by src/shared/messaging/config.py (env_prefix=RABBITMQ_)

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
# Backward-compatible alias used by some queue tooling:
RABBITMQ_VHOST=/

# Optional connection + queue tuning
RABBITMQ_HEARTBEAT=60
RABBITMQ_CONNECTION_TIMEOUT=30
RABBITMQ_BLOCKED_CONNECTION_TIMEOUT=30
RABBITMQ_QUEUE_MAX_LENGTH=10000
RABBITMQ_QUEUE_MESSAGE_TTL=86400000
RABBITMQ_PUBLISH_RETRY_MAX_ATTEMPTS=3
RABBITMQ_PUBLISH_RETRY_BASE_DELAY=1.0
RABBITMQ_PUBLISH_RETRY_MAX_DELAY=60.0
RABBITMQ_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
RABBITMQ_CIRCUIT_BREAKER_TIMEOUT=60.0
RABBITMQ_CONSUMER_PREFETCH_COUNT=10
RABBITMQ_MESSAGE_PERSISTENCE=true
RABBITMQ_PUBLISHER_CONFIRMS=true
RABBITMQ_ALTERNATE_EXCHANGE_ENABLED=true

# Optional direct URL override used by Kimi queue mode
RABBITMQ_URL=


# =============================================================================
# ArXiv Fetcher
# =============================================================================

# Scheduler cadence
ARXIV_FETCH_INTERVAL_MINUTES=30

# Worker config (src/workers/arxiv_fetcher/config.py, env_prefix=ARXIV_)
# Comma-separated list of arXiv categories to monitor.
# Defaults to the full research-domain map if unset.
ARXIV_CATEGORIES=q-fin.TR,q-fin.ST,stat.ML,cs.LG,math.ST,math.PR,eess.SP,eess.SY,math.DS,math.OC,cs.IT,cond-mat.stat-mech,cond-mat.dis-nn,cond-mat.soft,nlin.SI,nlin.CD,nlin.PS,stat.ME,econ.EM,stat.AP,cs.AI,cs.SI,cs.DS,cs.CL,cs.PF,q-bio.NC,q-bio.QM,q-bio.PE,q-bio.OT,math.MG,math.AT,math.NA,cond-mat.mtrl-sci,physics.flu-dyn,physics.geo-ph,econ.TH,econ.GN
ARXIV_MAX_RESULTS_PER_CATEGORY=50
ARXIV_DAYS_BACK=1
ARXIV_RATE_LIMIT_REQUESTS_PER_SECOND=0.33
ARXIV_MAX_CONCURRENT_CATEGORIES=3
ARXIV_OUTPUT_QUEUE=paper.triage.request
ARXIV_DEDUP_LOOKBACK_DAYS=30


# =============================================================================
# Artifact Storage
# =============================================================================

ARTIFACT_STORE_TYPE=local
ARTIFACTS_BASE_DIR=./artifacts


# =============================================================================
# Notifier (Slack)
# =============================================================================

SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#research-alerts


# =============================================================================
# Kimi Worker (Option 1 queue-integrated mode)
# =============================================================================

# Optional path overrides
KIMI_WORKER_REPO_ROOT=
KIMI_WORKER_RUNS_ROOT=

# Runtime watchdog override (seconds)
KIMI_WORKER_STUCK_TIMEOUT_SECONDS=300

# Queue routing for Kimi worker
KIMI_WORKER_EXCHANGE=researcher
KIMI_WORKER_JOB_QUEUE=experiment.job.request
KIMI_WORKER_JOB_ROUTING_KEY=experiment.job.request
KIMI_WORKER_RESULT_QUEUE=experiment.result
KIMI_WORKER_RESULT_ROUTING_KEY=experiment.result
KIMI_WORKER_PREFETCH=1
