# Dockerfile for Worker Services
# Used by: ArXiv Fetcher, Paper Triage, PDF Parser, Concept Generator, Experiment Exploder, Notifier

FROM python:3.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml ./
COPY .python-version ./

# Install uv
RUN pip install --no-cache-dir uv

# Install dependencies
RUN uv pip install --system -r <(uv pip compile pyproject.toml)

# Copy source code
COPY src/ ./src/
COPY config/ ./config/

# Create artifacts directory
RUN mkdir -p /app/artifacts

# Default command (override per service)
CMD ["python", "-m", "src.main", "--help"]
