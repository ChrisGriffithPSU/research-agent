# Dockerfile for Worker Services
# Used by: ArXiv Fetcher, Paper Triage, PDF Parser, Concept Generator, Experiment Exploder, Notifier

FROM python:3.13-slim

WORKDIR /app

ARG UV_EXTRA=main
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml ./
COPY uv.lock ./
COPY .python-version ./

# Install uv
RUN pip install --no-cache-dir uv

# Install dependencies (from lockfile)
RUN uv sync --frozen --no-dev --no-install-project --extra ${UV_EXTRA}

# Copy source code
COPY src/ ./src/
COPY workers/ ./workers/
COPY config/ ./config/

# Create artifacts directory
RUN mkdir -p /app/artifacts

# Default command (override per service)
CMD ["python", "-m", "src.main", "--help"]
